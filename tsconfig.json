{
  // Backend (Forge functions). The Forge CLI compiles src/ with ts-loader and its
  // bundled TypeScript 5.9 using this file, so keep options 5.9-compatible and
  // do not set "noEmit" here (ts-loader needs to emit). `npm run typecheck` passes --noEmit.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src"]
}
